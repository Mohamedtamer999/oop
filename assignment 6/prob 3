import java.util.Scanner;

class ArrayStatistics {
    private float maxValue;
    private float minValue;

    public float getMaxValue() {
        return maxValue;
    }

    public float getMinValue() {
        return minValue;
    }

    public void findMaxMin(float[] values) {
        if (values == null || values.length == 0) {
            maxValue = 0.0f;
            minValue = 0.0f;
            return;
        }

        maxValue = values[0];
        minValue = values[0];

        for (int i = 1; i < values.length; i++) {
            if (values[i] > maxValue) {
                maxValue = values[i];
            }
            if (values[i] < minValue) {
                minValue = values[i];
            }
        }
    }
}

public class ArrayStatisticsTest {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter the number of elements: ");
        int n = scanner.nextInt();

        float[] values = new float[n];
        System.out.print("Enter the array elements: ");
        for (int i = 0; i < n; i++) {
            values[i] = scanner.nextFloat();
        }

        ArrayStatistics stats = new ArrayStatistics();
        stats.findMaxMin(values);

        System.out.println("Maximum value: " + stats.getMaxValue());
        System.out.println("Minimum value: " + stats.getMinValue());

        scanner.close();
    }
}
