package javaapplication2;
import java.util.Scanner;
/**
 *
 * @author ADMIN-FUE
 */
public class JavaApplication2 {

   
    public static void main(String[] args) {
           Scanner input = new Scanner(System.in);

        String[][] students = new String[3][2];
        int countA = 0;
        int countPrefix = 0;

        
        for (int i = 0; i < 3; i++) {
            System.out.print("Enter student " + (i + 1) + " name: ");
            students[i][0] = input.nextLine();

            System.out.print("Enter student " + (i + 1) + " grade: ");
            students[i][1] = input.nextLine();
        }

        
        System.out.println("\nStudents:");
        for (int i = 0; i < 3; i++) {
            System.out.println(
                students[i][0].concat(": ").concat(students[i][1])
            );
        }

      
        for (int i = 0; i < 3; i++) {
            if (students[i][1].equalsIgnoreCase("A")) {
                countA++;
            }
        }

        System.out.println("Number of students with grade A: " + countA);

       
        System.out.print("Enter a prefix: ");
        String prefix = input.nextLine();

        for (int i = 0; i < 3; i++) {
            if (students[i][0].startsWith(prefix)) {
                countPrefix++;
            }
        }

        System.out.println("Number of names starting with "
                + prefix + ": " + countPrefix);

        input.close();
    }
}
