public class Invoice {

    private String invoiceID;
    private double discount;
    private double totalInvoice;

    public Invoice(String invoiceID, double discount, double totalInvoice) {
        this.invoiceID = invoiceID;
        this.discount = discount;
        this.totalInvoice = totalInvoice;
    }

    public Invoice() {
        this.invoiceID = "1";
        this.discount = 2.5;
        this.totalInvoice = 100;
    }

    public String getInvoiceID() {
        return invoiceID;
    }

    public double getDiscount() {
        return discount;
    }

    public double getTotalInvoice() {
        return totalInvoice;
    }

    public double calculateDiscountPrice() {
        return totalInvoice - (totalInvoice * discount / 100);
    }

    public static void main(String[] args) {

        Invoice inv = new Invoice();

        System.out.println("Invoice ID: " + inv.getInvoiceID());
        System.out.println("Old Discount: " + inv.getDiscount() + "%");
        System.out.println("Old Invoice Price: " + inv.getTotalInvoice());

        inv.discount = 5.5;
        inv.totalInvoice = 200;

        System.out.println("\nNew Discount: " + inv.getDiscount() + "%");
        System.out.println("New Invoice Price: " + inv.getTotalInvoice());

        System.out.println("Price After Discount: "
                + inv.calculateDiscountPrice());
    }
}
