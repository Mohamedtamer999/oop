import java.util.Scanner;

class CashRegister {

    private int itemCount;
    private double totalPrice;

    public CashRegister() {
        itemCount = 0;
        totalPrice = 0.0;
    }

    public CashRegister(int itemCount, double totalPrice) {
        this.itemCount = itemCount;
        this.totalPrice = totalPrice;
    }

    public void addItem(double price) {
        itemCount++;
        totalPrice += price;
    }

    public void clear() {
        itemCount = 0;
        totalPrice = 0.0;
    }

    public int getItemCount() {
        return itemCount;
    }

    public double getTotalPrice() {
        return totalPrice;
    }
}

public class Main {
    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        CashRegister register = new CashRegister();

        System.out.print("Enter the price of the first item: ");
        double price1 = input.nextDouble();

        System.out.print("Enter the price of the second item: ");
        double price2 = input.nextDouble();

        register.addItem(price1);
        register.addItem(price2);

        System.out.println("\nCash Register Information:");
        System.out.println("Item Count: " + register.getItemCount());
        System.out.println("Total Price: " + register.getTotalPrice());

        register.clear();

        System.out.println("\nAfter clearing:");
        System.out.println("Item Count: " + register.getItemCount());
        System.out.println("Total Price: " + register.getTotalPrice());

        input.close();
    }
}
