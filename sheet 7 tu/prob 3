import java.util.Scanner;

class Book {

    private String title;
    private String author;
    private double price;

    public Book() {
        title = "Unknown";
        author = "Unknown";
        price = 0.0;
    }

    public Book(String title, String author, double price) {
        this.title = title;
        this.author = author;
        this.price = price;
    }

    public void applyDiscount(double percentage) {
        price = price - (price * percentage / 100);
    }

    public boolean isExpensive() {
        return price > 500;
    }

    public String getTitle() {
        return title;
    }

    public String getAuthor() {
        return author;
    }

    public double getPrice() {
        return price;
    }
}

public class Main {

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        System.out.print("Enter number of books: ");
        int n = input.nextInt();

        Book[] books = new Book[n];

        for (int i = 0; i < n; i++) {

            input.nextLine();

            System.out.println("Enter details of book " + (i + 1));

            System.out.print("Enter title: ");
            String title = input.nextLine();

            System.out.print("Enter author: ");
            String author = input.nextLine();

            System.out.print("Enter price: ");
            double price = input.nextDouble();

            books[i] = new Book(title, author, price);
        }

        System.out.print("Enter the index of the book for discount (0 to "
                + (n - 1) + "): ");
        int index = input.nextInt();

        System.out.print("Enter discount percentage: ");
        double percentage = input.nextDouble();

        books[index].applyDiscount(percentage);

        System.out.println("===== Books Information =====");

        for (int i = 0; i < n; i++) {

            System.out.println("Book " + i);

            System.out.println("Title: " + books[i].getTitle());

            System.out.println("Author: " + books[i].getAuthor());

            System.out.println("Price: " + books[i].getPrice());

            if (books[i].isExpensive()) {
                System.out.println("Expensive: Yes");
            } else {
                System.out.println("Expensive: No");
            }
        }
    }
}
