
  
class LibraryItem {
    private int itemID;
    private String title;
    private int publicationYear;

    public LibraryItem(int itemID, String title, int publicationYear) {
        this.itemID = itemID;
        this.title = title;
        this.publicationYear = publicationYear;
    }

    public int getItemID() {
        return itemID;
    }

    public void setItemID(int itemID) {
        this.itemID = itemID;
    }

    public String getTitle() {
        return title;
    }

    public void setTitle(String title) {
        this.title = title;
    }

    public int getPublicationYear() {
        return publicationYear;
    }

    public void setPublicationYear(int publicationYear) {
        this.publicationYear = publicationYear;
    }

    public double calculateLateFee(int days) {
        return days * 5.0;
    }

    public double calculateLateFee(int days, double discount) {
        double fee = calculateLateFee(days);
        return fee - (fee * discount / 100);
    }

    public void displayInfo() {
        System.out.println("Item ID: " + itemID);
        System.out.println("Title: " + title);
        System.out.println("Publication Year: " + publicationYear);
    }

    @Override
    public String toString() {
        return "Item ID: " + itemID +
               ", Title: " + title +
               ", Publication Year: " + publicationYear;
    }
}


class PrintedBook extends LibraryItem {
    private String author;
    private int numberOfPages;

    public PrintedBook(int itemID, String title, int publicationYear,
                       String author, int numberOfPages) {

        super(itemID, title, publicationYear);
        this.author = author;
        this.numberOfPages = numberOfPages;
    }

    @Override
    public double calculateLateFee(int days) {
        return days * 7.0;
    }

    @Override
    public void displayInfo() {
        super.displayInfo();
        System.out.println("Author: " + author);
        System.out.println("Number of Pages: " + numberOfPages);
    }

    @Override
    public String toString() {
        return super.toString() +
               ", Author: " + author +
               ", Number of Pages: " + numberOfPages;
    }
}


class DigitalResource extends LibraryItem {
    private String fileFormat;
    private double fileSize;

    public DigitalResource(int itemID, String title, int publicationYear,
                           String fileFormat, double fileSize) {

        super(itemID, title, publicationYear);
        this.fileFormat = fileFormat;
        this.fileSize = fileSize;
    }

    @Override
    public double calculateLateFee(int days) {
        return days * 3.0;
    }

    @Override
    public void displayInfo() {
        super.displayInfo();
        System.out.println("File Format: " + fileFormat);
        System.out.println("File Size: " + fileSize + " MB");
    }

    @Override
    public String toString() {
        return super.toString() +
               ", File Format: " + fileFormat +
               ", File Size: " + fileSize + " MB";
    }
}


public class Main {
    public static void main(String[] args) {

        PrintedBook book = new PrintedBook(
            101, "Java Programming", 2023,
            "John Smith", 350
        );

        DigitalResource digital = new DigitalResource(
            102, "Java E-Book", 2024,
            "PDF", 25.5
        );

        System.out.println(" Printed Book ");
        book.displayInfo();

        System.out.println("Late Fee (5 days): "
                           + book.calculateLateFee(5) + " EGP");

        System.out.println(" Digital Resource ");
        digital.displayInfo();

        System.out.println("Late Fee (5 days): "
                           + digital.calculateLateFee(5) + " EGP");

        System.out.println(" Method Overloading ");
        System.out.println("Late Fee with 10% discount: "
                           + book.calculateLateFee(5, 10) + " EGP");

        System.out.println(" toString() ");
        System.out.println(book);
        System.out.println(digital);

        System.out.println(" Polymorphism ");
        LibraryItem item = new PrintedBook(
            103, "OOP in Java", 2025,
            "Ahmed Ali", 400
        );

        System.out.println("Late Fee (5 days): "
                           + item.calculateLateFee(5) + " EGP");
    }
}
