public class employee {
     private String name;
    private int id;
    private double salary;
    
    public employee(String name, int id, double salary){
        this.name = name;
        this.id = id;
        this.salary = salary;
    }
    public double calculateBonus(){
        return salary * 10;
    }
    public void displayInfo(){
        System.out.println("Name: " + name);
        System.out.println("Id: " + id);
        System.out.println("Salary: " + salary);
        System.out.println("Bonus: " + calculateBonus());
    }

    public String getName() {
        return name;
    }

    public int getId() {
        return id;
    }

    public double getSalary() {
        return salary;
    }

    @Override
    public String toString() {
        return  "name=" + name + ", id=" + id + ", salary=" + salary ;
    }
}



public class manager extends employee {
    
    private String department;
    private double allowance;
    
    public manager(String name, int id, double salary, String department, double allowance){
        super(name , id , salary);
        this.department = department;
        this.allowance = allowance;
    }
    @Override
    public double calculateBonus(){
        return getSalary() * 30;
    }
    @Override
    public void displayInfo(){
        super.displayInfo();
        System.out.println("Department: " + department);
        System.out.println("Allowance: " + allowance);
    }
     @Override
    public String toString() {
        return super.toString()+ "department=" + department + "allowance=" + allowance;
                
    }               
}



public class JavaApplication74 {

 public static void main(String[] args) {
       
        employee emp = new employee("Ahmed", 101, 5000);

       
        manager mgr = new manager(
            "Sara", 201, 10000, "IT", 2000
        );

        employee ref = new manager(
            "Omar", 301, 12000, "HR", 3000
        );

        System.out.println("Employee Bonus: " +
                           emp.calculateBonus());

        System.out.println("Employee Bonus (15%): " +
                           emp.calculateBonus(15));

        System.out.println("Manager Bonus: " +
                           mgr.calculateBonus());

        System.out.println(" Employee Information ");
        emp.displayInfo();

        System.out.println(" Manager Information ");
        mgr.displayInfo();

        System.out.println("Using println() ");
        System.out.println(emp);
        System.out.println(mgr);

        System.out.println(" Parent Reference ");
        ref.displayInfo();

        System.out.println("Bonus using parent reference: " +
                           ref.calculateBonus());

        System.out.println(ref);
    }
}
